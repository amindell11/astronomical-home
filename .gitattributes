# Shell scripts and git hooks must stay LF so they run under bash on Windows
# (a CRLF shebang line becomes a "bad interpreter" error).
*.sh text eol=lf
.githooks/** text eol=lf

# Design-vault images stay in LFS (doc/design is the Obsidian vault; see doc/agents/design-docs.md)
doc/design/**/*.png filter=lfs diff=lfs merge=lfs -text
