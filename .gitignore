# Repo-level ignores. Unity-generated files are covered by src/Asteroids3D/.gitignore.

# Logs land beside whatever produced them
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Generated test/run artifacts
/results/
/TestResults/
/test-results/

# RL training player build output
/build/

# Durable RL run archive (checkpoints/eval summaries; kept out of git, NOT disposable — see memory rl_training_run_mechanics)
/training/archive/*
# Parked source rather than run output: small enough to track, and losing it is what parking prevents.
!/training/archive/2026-07-24-ram-bench-harness/

# Agent scratch space (capture scenarios are authored here, outside Assets)
/scratch/

# Agent worktree pool
.worktree-pool/

# Claude session-local state
.claude/scheduled_tasks.lock

# ai-counsel MCP writes debate transcripts here
/transcripts/

nul
__pycache__/
