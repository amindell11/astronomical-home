diff --git a/scripts/tests/test_unity_access.ps1 b/scripts/tests/test_unity_access.ps1
index 76125d99d..18d25a9d1 100644
--- a/scripts/tests/test_unity_access.ps1
+++ b/scripts/tests/test_unity_access.ps1
@@ -361,6 +361,21 @@ try {
     Assert-Equal $editorStrict.value.status "blocked_user_editor" "editor-mode block classification"
     [void](Invoke-Coordinator -Action Cancel -Lease editor-strict)
 
+    $coexist = @{ CoexistWithUserEditor = 41001 }
+    $allowed = Invoke-Coordinator -Action Acquire -Lease coexist -Mode editor -ProjectPath $agentProject -Extra $coexist -RealProcess
+    Assert-Equal $allowed.value.status "acquired" "explicit cross-project coexistence acquires"
+    $bootAllowed = Invoke-Coordinator -Action BootAcquire -Lease coexist -Mode editor -ProjectPath $agentProject -Extra $coexist
+    Assert-Equal $bootAllowed.value.status "boot_acquired" "coexistence retains coordinated boot"
+    $visible = Invoke-Coordinator -Action Status -Extra $coexist
+    Assert-Equal $visible.value.blockers[0].processId 41001 "coexisting user editor remains visible"
+    [void](Invoke-Coordinator -Action Release -Lease coexist)
+    $sameUser = Invoke-Coordinator -Action Acquire -Lease coexist-same -Mode editor -ProjectPath $mainProject -Extra $coexist
+    Assert-Equal $sameUser.value.status "blocked_user_editor" "coexistence never grants the user's project"
+    [void](Invoke-Coordinator -Action Cancel -Lease coexist-same)
+    $wrongPid = Invoke-Coordinator -Action Acquire -Lease coexist-wrong -Mode editor -ProjectPath $agentProject -Extra @{ CoexistWithUserEditor = 41003 }
+    Assert-Equal $wrongPid.value.status "blocked_user_editor" "coexistence only covers the specified editor"
+    [void](Invoke-Coordinator -Action Cancel -Lease coexist-wrong)
+
     Write-Snapshot @([ordered]@{ processId = 41002; commandLine = "Unity.exe -batchMode -projectPath `"$mainProject`"" })
     $unmanaged = Invoke-Coordinator -Action Acquire -Lease unmanaged -ProjectPath $agentProject
     Assert-Equal $unmanaged.code 21 "unmanaged batch process exit"
